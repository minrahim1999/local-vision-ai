# local-vision-ai environment variables
# Copy to .env and fill in your values.

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# Model cache / weights directories
MODEL_CACHE_DIR=./models
HF_HOME=./models/huggingface

# Text-to-Image
T2I_MODEL_ID=runwayml/stable-diffusion-v1-5
T2I_DEVICE=mps
T2I_SAFETY_CHECKER=false
T2I_DEFAULT_WIDTH=512
T2I_DEFAULT_HEIGHT=512
T2I_DEFAULT_STEPS=20
T2I_DEFAULT_GUIDANCE_SCALE=7.0

# Image-to-Text
I2T_MODEL_ID=mlx-community/smolvlm-256m-8bit
I2T_MAX_TOKENS=512
I2T_TEMPERATURE=0.2

# Memory manager
IDLE_TIMEOUT_SECONDS=300
MEMORY_WARN_MB=12000
MEMORY_LIMIT_MB=14000

# Training (optional)
WANDB_PROJECT=local-vision-ai
